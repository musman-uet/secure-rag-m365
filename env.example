# Copy to .env and fill in. Never commit .env.

# "local" runs fully offline. "azure" uses Azure AI Search + Azure OpenAI.
RAG_BACKEND=local

# --- Azure AI Search ---
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=secure-rag-chunks
# Semantic ranker: available on the Free tier with a limited number of requests per month.
AZURE_SEARCH_SEMANTIC=true

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536
